EMBEDDING_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIMENSIONS=1024

# ask 命令的聊天后端：anthropic | openai | ollama
# - anthropic: 走 Anthropic 原生 /v1/messages（如 claude.jlcops.com/api）
# - openai: 走 OpenAI 兼容 /chat/completions（含 Ollama 的 /v1 兼容端点）
# - ollama: 走 Ollama 原生 /api/chat
CHAT_PROVIDER=anthropic
OPENAI_API_KEY=
OPENAI_BASE_URL=https://claude.jlcops.com/api
OPENAI_CHAT_MODEL=glm-5.2

LANCEDB_PATH=data/lancedb
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
EMBEDDING_BATCH_SIZE=1
OUTPUT_DIR=output

# OCR 语言模型目录（扫描版 PDF 需要）
TESSDATA_PREFIX=./tessdata
